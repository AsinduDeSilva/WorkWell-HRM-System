<Page x:Class="WorkWell.Views.Admin.EmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="680" d:DesignWidth="768"
      Title="EmployeePage">

    <Grid Background="White">
        <TextBlock HorizontalAlignment="Left" Margin="0,0,0,0" TextWrapping="Wrap" Text="Employees" VerticalAlignment="Top" Height="37" Width="172" FontSize="28" FontWeight="SemiBold"/>
        <Button  Command="{Binding AddEmployeeCommand}" Background="#213447" Foreground="White" x:Name="Add_Employee" Content="+ Add Employee" HorizontalAlignment="Left" Height="27" Margin="570,66,0,0" VerticalAlignment="Top" Width="134"/>
        <TextBox  Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="197" Margin="0,66,0,0"/>
        <Button Command="{Binding SearchCommand}" Background="#213447" Foreground="White" Content="Search" HorizontalAlignment="Left" Height="23" Margin="217,66,0,0" VerticalAlignment="Top" Width="100"/>

        <ComboBox ItemsSource="{Binding Departments}"  SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}" SelectedIndex="0" HorizontalAlignment="Left" Height="23" Margin="93,129,0,0" VerticalAlignment="Top" Width="86"/>

        <TextBlock HorizontalAlignment="Left" Height="23" Margin="4,129,0,0" TextWrapping="Wrap" Text="Department" VerticalAlignment="Top" FontSize="14"/>
        <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition, Mode=TwoWay}" SelectedIndex="0" HorizontalAlignment="Left" Height="23" Margin="279,130,0,0" VerticalAlignment="Top" Width="86"/>

        <TextBlock HorizontalAlignment="Left" Height="23" Margin="215,130,0,0" TextWrapping="Wrap" Text="Position" VerticalAlignment="Top" FontSize="14"/>
        <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" HorizontalAlignment="Left" Height="335" Margin="4,194,0,0" VerticalAlignment="Top" Width="710">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeID}" Width="1*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department.DepartmentName}" Width="2*"/>
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="2*"/>
            </DataGrid.Columns>
            
        </DataGrid>
        <Button Command="{Binding ClearCommand}" Background="#213447" Foreground="White" Content="Clear" HorizontalAlignment="Left" Height="23" Margin="411,130,0,0" VerticalAlignment="Top" Width="100"/>
    </Grid>
</Page>
