<Page x:Class="WorkWell.Views.HR.LeaveRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="LeaveRequests"
      Background="White"
      d:DesignHeight="640" d:DesignWidth="768"
>
      

    <Grid>
        <StackPanel>
            <TextBlock Text="Leave Requests"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,20"/>

            <DataGrid x:Name="LeaveRequestsGrid"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      Background="White"
                      BorderBrush="#BDC3C7"
                      BorderThickness="1"
                      RowHeight="42"
                      FontSize="15"
                      FontFamily="Segoe UI"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}" Width="1.5*" />
                    <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                    <DataGridTextColumn Header="Leave Type" Binding="{Binding Reason}" Width="1.5*" />
                    <DataGridTemplateColumn Header="Action" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                                    <Button Content="Accept"
                                            Width="80"
                                            Height="32"
                                            Margin="5,0"
                                            Background="#2ECC71"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            BorderThickness="0"/>
                                    <Button Content="Decline"
                                            Width="80"
                                            Height="32"
                                            Margin="5,0"
                                            Background="#E74C3C"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
