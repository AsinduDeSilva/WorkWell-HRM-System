<Page x:Class="WorkWell.Views.Employee.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Employee"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Settings">

    <Grid Background="White">
        <Border Width="572" Padding="0 0 0 30" Background="White" CornerRadius="10" 
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Height="410" >
            <StackPanel Margin="0,0,-144,-20">

                <TextBlock Text="Change Password" FontSize="28" FontWeight="Bold" Margin="0 0 0 30"/>

                <TextBlock Text="Current Password"/>
                <PasswordBox x:Name="txtCurrentPassword" Margin="0,5,0,15" Height="25" Width="500" HorizontalAlignment="Left" PasswordChanged="txtCurrentPassword_PasswordChanged"/>

                <TextBlock Text="New Password"/>
                <PasswordBox x:Name="txtNewPassword" Margin="0,5,0,15" Height="25" Width="500" HorizontalAlignment="Left" PasswordChanged="txtNewPassword_PasswordChanged"/>

                <TextBlock Text="Confirm New Password"/>
                <PasswordBox x:Name="txtConfirmPassword"   Margin="0,5,0,25" Height="25" Width="500" HorizontalAlignment="Left" PasswordChanged="txtConfirmPassword_PasswordChanged"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                    <Button Content="Save" Height="32" Width="200" Margin="0,0,10,0" Background="Black" Foreground="White" Command="{Binding ChangePasswordCommand}"/>
                    <Button Content="Cancel" Height="32" Width="200" Background="Black" Foreground="White" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
