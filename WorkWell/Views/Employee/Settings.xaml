<Page x:Class="WorkWell.Views.Employee.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Employee"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Settings">

    <Grid Background="White">
        <Border Width="400" Padding="0 0 0 30" Background="White" CornerRadius="10" 
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" >
            <StackPanel>

                <TextBlock Text="Change Password" FontSize="28" FontWeight="Bold" Margin="0 0 0 30"/>

                <TextBlock Text="Current Password"/>
                <PasswordBox x:Name="txtCurrentPassword" Margin="0,5,0,15"/>

                <TextBlock Text="New Password"/>
                <PasswordBox x:Name="txtNewPassword" Margin="0,5,0,15"/>

                <TextBlock Text="Confirm New Password"/>
                <PasswordBox x:Name="txtConfirmPassword" Margin="0,5,0,25"/>
                <Button Content="Update Password" Width="180" Height="35"
                        Background="Black" Foreground="White" HorizontalAlignment="Left"
                        />
            </StackPanel>
        </Border>
    </Grid>
</Page>
