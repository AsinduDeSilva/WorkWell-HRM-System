<Page x:Class="WorkWell.Views.Employee.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Employee"
      mc:Ignorable="d" 
      d:DesignHeight="640" d:DesignWidth="768"
      Title="Profile">

    <Grid Background="White" Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>




            <StackPanel Grid.Column="1" Margin="60,0,0,0">
                <TextBlock Text="{Binding Name}" FontSize="26" Margin="0 0 0 40"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="User ID" FontSize="15" Grid.Row="0" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding EmployeeId}" FontSize="15" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="NIC" FontSize="15" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding NIC}" FontSize="15" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Department" FontSize="15" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Department}" FontSize="15" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Position" FontSize="15" Grid.Row="3" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Position}" FontSize="15" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock Text="Contact" FontSize="15" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Contact}" FontSize="15" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock Text="Gender" FontSize="15" Grid.Row="5" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Gender}" FontSize="15" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock Text="Email" FontSize="15" Grid.Row="6" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Email}" FontSize="15" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock Text="Salary" FontSize="15" Grid.Row="7" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Salary}" FontSize="15" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock Text="Medical Leaves" FontSize="15" Grid.Row="8" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding SickLeaves}" FontSize="15" Grid.Row="8" Grid.Column="1"/>

                    <TextBlock Text="Casual Leaves" FontSize="15" Grid.Row="9" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding CasualLeaves}" FontSize="15" Grid.Row="9" Grid.Column="1"/>

                    <TextBlock Text="Vacation Leaves" FontSize="15" Grid.Row="10" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding VacationLeaves}" FontSize="15" Grid.Row="10" Grid.Column="1"/>
                </Grid>
            </StackPanel>
            <Image Source="/Assets/Profile.jpg" HorizontalAlignment="Left" Height="184" Margin="7,62,0,0" VerticalAlignment="Top" Width="183" RenderTransformOrigin="-0.283,-0.164"/>
            <Ellipse HorizontalAlignment="Center" Height="190" Margin="0,62,0,0" Stroke="Black" VerticalAlignment="Top" Width="190" StrokeThickness="5"/>
        </Grid>
    </Grid>
</Page>
