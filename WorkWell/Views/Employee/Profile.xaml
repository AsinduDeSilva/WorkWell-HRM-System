<Page x:Class="WorkWell.Views.Employee.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Employee"
      mc:Ignorable="d" 
      d:DesignHeight="640" d:DesignWidth="768"
      Title="Profile">

    <Grid Background="White" Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>




            <StackPanel Grid.Column="1" Margin="30,0,0,0">
                <TextBlock Text="Dewmi Samadhi" FontSize="26" Margin="0 0 0 40"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="User ID" FontSize="15" Grid.Row="0" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="001" FontSize="15" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Name" FontSize="15" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Dewmi Samadhi" FontSize="15" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="NIC" FontSize="15" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="123456789" FontSize="15" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Department" FontSize="15" Grid.Row="3" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="IT" FontSize="15" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock Text="Position" FontSize="15" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Web Developer and Designer" FontSize="15" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock Text="Contact" FontSize="15" Grid.Row="5" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="123 456 7890" FontSize="15" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock Text="Email" FontSize="15" Grid.Row="6" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="dewmi@gmail.com" FontSize="15" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock Text="Salary" FontSize="15" Grid.Row="7" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="$70" FontSize="15" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock Text="Remaining Leave Count" FontSize="15" Grid.Row="8" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="15" FontSize="15" Grid.Row="8" Grid.Column="1"/>
                </Grid>
            </StackPanel>
            <Image Source="/Views/Employee/Profile.jpg" HorizontalAlignment="Left" Height="184" Margin="7,62,0,0" VerticalAlignment="Top" Width="183" RenderTransformOrigin="-0.283,-0.164"/>

        </Grid>
    </Grid>
</Page>
