<Page x:Class="WorkWell.Views.Admin.HRMProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="640" d:DesignWidth="768"
      Title="HRMProfilePage">

    <Grid Background="White" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="/Assets/Profile.jpg"
           Grid.Column="0"
           Height="184"
           Width="183"
           Margin="7,62,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
    />

        <StackPanel Grid.Column="1" Margin="60,0,0,0">
            <TextBlock Text="Dewmi Samadhi" FontSize="26" Margin="0 0 0 40"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="HR Manager ID" Grid.Row="0" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding HRManagerID}" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="Name" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding Name}" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="NIC" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding NIC}" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Contact" Grid.Row="3" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding Contact}" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Email" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding Email}" Grid.Row="4" Grid.Column="1"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                <Button Command="{Binding UpdateCommand}" Content="Update" Width="100" Height="30" Background="#213447" Foreground="White" Margin="0,0,20,0"/>
                <Button Command="{Binding DeleteCommand}" Content="Delete" Width="100" Height="30" Background="#213447" Foreground="White"/>
                
            </StackPanel>
        </StackPanel>
        <Ellipse HorizontalAlignment="Center" Height="190" Margin="0,62,0,0" Stroke="Black" VerticalAlignment="Top" Width="190" StrokeThickness="5"/>
    </Grid>
</Page>
