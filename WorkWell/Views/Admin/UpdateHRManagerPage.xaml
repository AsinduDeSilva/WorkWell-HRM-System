<Page x:Class="WorkWell.Views.Admin.UpdateHRManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkWell.Views.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="640" d:DesignWidth="768"
      Title="UpdateHRManagerPage">

    <Grid Background="White">
        <TextBlock HorizontalAlignment="Left" Margin="0" TextWrapping="Wrap" Text="Update HR Manager" VerticalAlignment="Top" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="10,106,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" FontSize="14" Width="82"/>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="10,66,0,0" TextWrapping="Wrap" Text="Manager ID" VerticalAlignment="Top" FontSize="14" Width="82"/>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="10,146,0,0" TextWrapping="Wrap" Text="NIC" VerticalAlignment="Top" FontSize="14" Width="82"/>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="10,226,0,0" TextWrapping="Wrap" Text="Department" VerticalAlignment="Top"  FontSize="14" Width="82" RenderTransformOrigin="0.482,2.705"/>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="10,304,0,0" TextWrapping="Wrap" Text="Contact Number" VerticalAlignment="Top"  FontSize="14" Width="106"/>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="10,344,0,0" TextWrapping="Wrap" Text="Email" VerticalAlignment="Top" Width="82"  FontSize="14" RenderTransformOrigin="0.496,8.419"/>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="10,186,0,0" TextWrapping="Wrap" Text="Gender" VerticalAlignment="Top"  FontSize="14" Width="82"/>

        <TextBox HorizontalAlignment="Left" Height="25" Margin="149,64,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="13" Width="435"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="149,144,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="13" Width="435"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="149,104,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="13" Width="435"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="149,302,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="13" Width="435"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="149,342,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="13" Width="435"/>
        <RadioButton Content="Male" HorizontalAlignment="Left" Margin="150,186,0,0" FontSize="13"  VerticalAlignment="Top"/>
        <RadioButton Content="Female" HorizontalAlignment="Left" Margin="264,186,0,0" FontSize="13"  VerticalAlignment="Top" Checked="RadioButton_Checked"/>

        <Button Content="Back" HorizontalAlignment="Left" Height="27" Margin="321,416,0,0" FontSize="13" VerticalAlignment="Top" Width="120"/>
        <Button Content="Update" HorizontalAlignment="Left" Height="27" Margin="464,416,0,0" FontSize="13" VerticalAlignment="Top" Width="120"/>
        <CheckBox Content="Finance" HorizontalAlignment="Left" Margin="150,226,0,0" FontSize="13" VerticalAlignment="Top"/>
        <CheckBox Content="Finance" HorizontalAlignment="Left" Margin="264,226,0,0" FontSize="13" VerticalAlignment="Top"/>
        <CheckBox Content="Finance" HorizontalAlignment="Left" Margin="378,226,0,0" FontSize="13" VerticalAlignment="Top"/>
        <CheckBox Content="Finance" HorizontalAlignment="Left" Margin="150,256,0,0" FontSize="13" VerticalAlignment="Top"/>
        <CheckBox Content="Finance" HorizontalAlignment="Left" Margin="264,256,0,0" FontSize="13" VerticalAlignment="Top"/>
    </Grid>
</Page>
